{
  "name": "simulation-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:sim": "tsx --tsconfig tsconfig.json scripts/check-simulations.ts",
